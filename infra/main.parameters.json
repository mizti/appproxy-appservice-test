{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=westus2}"
    },
    "authClientId": {
      "value": "${AUTH_CLIENT_ID}"
    },
    "authTenantId": {
      "value": "${AUTH_TENANT_ID}"
    },
    "authClientSecret": {
      "value": "${AUTH_CLIENT_SECRET}"
    },
    "connectorAllowedRdpCidr": {
      "value": "${CONNECTOR_ALLOWED_RDP_CIDR}"
    },
    "connectorAdminUsername": {
      "value": "${CONNECTOR_ADMIN_USERNAME=azureuser}"
    },
    "connectorAdminPassword": {
      "value": "${CONNECTOR_ADMIN_PASSWORD}"
    },
    "connectorVmSize": {
      "value": "${CONNECTOR_VM_SIZE=Standard_D2s_v5}"
    }
  }
}
